          }
        ],
        "table": {
          "meta": [
            {
              "colKey": "name",
              "colName": "Department",
              "type": "text"
            },
            {
              "colKey": "count",
              "colName": "Completed",
              "type": "text"
            }
          ],
          "data": [
            {
