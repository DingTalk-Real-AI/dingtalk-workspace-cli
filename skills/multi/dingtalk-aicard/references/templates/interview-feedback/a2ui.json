        {
          "id": "invalid-step",
          "component": "Text",
          "text": "表单状态异常，请重新打开或联系发起人。",
          "maxLine": 30,
          "colorToken": "common_level2_base_color",
          "visible": {
            "call": "not",
            "args": {
              "value": {
                "call": "or",
                "args": {
                  "values": [
                    {
                      "call": "eq",
                      "args": {
                        "a": {
                          "path": "/view/step"
                        },
                        "b": 1
                      }
                    },
                    {
                      "call": "eq",
                      "args": {
                        "a": {
                          "path": "/view/step"
                        },
                        "b": 2
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
