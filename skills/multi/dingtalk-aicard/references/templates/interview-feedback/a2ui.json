                "identity": {
                  "path": "/identity"
                },
                "form": {
                  "path": "/form"
                },
                "step": {
                  "path": "/view/step"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/form/level"
                  }
                }
              },
              "message": "请输入职级"
            }
