          "colorToken": "common_level2_base_color",
          "bold": true
        },
        {
          "id": "conclusion",
          "component": "ChoicePicker",
          "variant": "mutuallyExclusive",
          "displayStyle": "checkbox",
          "value": {
            "path": "/form/conclusion"
          },
          "options": [
            {
              "label": "通过",
              "value": "pass"
            },
            {
              "label": "不通过",
              "value": "reject"
            }
          ],
          "disabled": false
