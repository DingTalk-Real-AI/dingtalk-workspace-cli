          "colorToken": "common_link_color",
          "bold": true
        },
        {
          "id": "review-confirm",
          "component": "Button",
          "child": "review-confirm-label",
          "variant": "primary",
          "disabled": false,
          "action": {
            "event": {
              "name": "interview_review_confirm",
              "context": {
                "identity": {
                  "path": "/identity"
                },
                "form": {
                  "path": "/form"
                },
                "step": {
                  "path": "/view/step"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/form/strengths"
                  }
                }
              },
              "message": "请补充候选人优点"
            },
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/form/pending"
                  }
                }
              },
              "message": "请补充待验证项"
            },
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/form/conclusion"
                  }
                }
              },
              "message": "请选择面试结论"
            }
          ],
          "weight": 1
        },
        {
          "id": "review-hint",
          "component": "Text",
          "text": "确认后将自动回填至面试系统",
