        {
          "id": "root",
          "component": "Column",
          "children": [
            "review",
            "recommendation",
            "invalid-step"
          ],
          "gap": 0,
          "align": "stretch"
        },
        {
          "id": "review-fields",
          "component": "Column",
          "children": [
            "strengths-group",
            "pending-group",
            "conclusion-group"
          ],
          "gap": 20,
