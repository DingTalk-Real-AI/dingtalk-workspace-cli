        },
        {
          "id": "strengths-label",
          "component": "Text",
          "text": "优点",
          "maxLine": 30,
          "variant": "caption",
          "colorToken": "common_level2_base_color",
          "bold": true
        },
        {
          "id": "strengths",
          "component": "TextField",
          "label": "",
          "value": {
            "path": "/form/strengths"
          },
          "variant": "longText",
          "disabled": false
        },
        {
          "id": "strengths-group",
          "component": "Column",
          "children": [
            "strengths-label",
            "strengths"
          ],
          "gap": 8,
          "align": "stretch",
          "padding": 0
        },
        {
          "id": "pending-label",
          "component": "Text",
          "text": "不足与待改进",
          "maxLine": 30,
          "variant": "caption",
          "colorToken": "common_level2_base_color",
          "bold": true
        },
        {
          "id": "pending",
          "component": "TextField",
          "label": "",
          "value": {
            "path": "/form/pending"
          },
          "variant": "longText",
          "disabled": false
        },
        {
          "id": "pending-group",
          "component": "Column",
          "children": [
            "pending-label",
            "pending"
          ],
          "gap": 8,
          "align": "stretch",
          "padding": 0
